# Port the API listens on
PORT=5000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/expense-tracker for local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/expense-tracker?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# The frontend URL that is allowed to call this API (CORS)
CLIENT_URL=http://localhost:5173
